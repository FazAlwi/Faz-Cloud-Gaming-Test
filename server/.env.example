# Server Configuration
PORT=4000
PUBLIC_HOST=localhost
# Use https in production behind Caddy/Nginx (required by Chrome for Pointer Lock & Gamepad APIs)
STREAM_PROTOCOL=http
CORS_ORIGIN=http://localhost:5173

# Region Metadata
REGION=asia-southeast1
REGION_LABEL=Singapore
GPU_MODEL=NVIDIA L4 (24GB)

# Capacity & Port Allocation (g2-standard-4 default: 2 concurrent GPU containers)
MAX_SLOTS=2
PORT_RANGE_START=8081
PORT_RANGE_END=8090

# Per-Container WebRTC UDP Media Port Range (20 UDP ports per slot -> 49152-49351 for 10 slots)
WEBRTC_UDP_PORT_START=49152
WEBRTC_UDP_PORTS_PER_SLOT=20

# Docker & LinuxServer Steam (Selkies + Proton) Settings
# Set MOCK_DOCKER=false on the GCP NVIDIA L4 host
MOCK_DOCKER=true
DOCKER_SOCKET_PATH=/var/run/docker.sock
SELKIES_IMAGE=lscr.io/linuxserver/steam:latest
# Container port: 3001 (built-in HTTPS, required for browser WebCodecs & Gaming Mode relative mouse capture)
# or 3000 (HTTP only when sitting behind an external HTTPS reverse proxy such as Caddy/Nginx)
SELKIES_CONTAINER_PORT=3001
# Hardware NVENC encoder for NVIDIA L4 (nvh264enc or h264enc)
SELKIES_ENCODER=nvh264enc
SELKIES_VIDEO_BITRATE=12000
SELKIES_FRAMERATE=60
PROTON_VERSION=GE-Proton9
PUID=1000
PGID=1000
TZ=Etc/UTC

# Host Storage Mounts (used when MOCK_DOCKER=false)
# /srv/saves/<userId> mounts to /config:rw (preserves Steam login token, Proton prefixes & saves)
SAVES_BASE_DIR=/srv/saves
# Optional shared read-only game library mounted to /config/.local/share/Steam/steamapps/common:ro
# Leave empty (GAMES_BASE_DIR=) to disable the shared library mount
GAMES_BASE_DIR=/srv/games

# Session Persistence (leave empty or unreachable to automatically fall back to in-memory Map)
REDIS_URL=

# Idle Session Reaper (60s sweep interval, 10 minute heartbeat TTL)
REAPER_INTERVAL_MS=60000
IDLE_TIMEOUT_MS=600000
